# Copy to .env.local after you create a Firebase project.
# DO NOT enable player accounts until all items in README → Accounts setup are done.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_URL=

# Cloud Functions base URL for sendEmailCode / verifyEmailCode
# Example: https://us-central1-your-project.cloudfunctions.net
VITE_AUTH_FUNCTIONS_URL=
